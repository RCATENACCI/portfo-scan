{
  "name": "Portfo Scan — Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  "updateContentCommand": "[ -f packages.txt ] && sudo apt-get update && sudo xargs apt-get install -y < packages.txt; pip3 install --user --upgrade pip; pip3 install --user -r requirements.txt",

  "postAttachCommand": {
    "server": "streamlit run app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true"
  },

  "portsAttributes": {
    "8501": {
      "label": "Portfo Scan",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },

  "forwardPorts": [
    8501
  ]
}